{
  "name": "git-crypt-explorer",
  "displayName": "Git Crypt Explorer",
  "description": "Highlights git-crypt protected files and provides target management, status, lock, unlock, key export, and GPG access commands.",
  "version": "0.4.5",
  "publisher": "YoungmukKang",
  "author": {
    "name": "YoungmukKang",
    "url": "https://github.com/ym-kang"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ym-kang/git-crypt-explorer.git"
  },
  "homepage": "https://github.com/ym-kang/git-crypt-explorer#readme",
  "bugs": {
    "url": "https://github.com/ym-kang/git-crypt-explorer/issues"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#071A3D",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git-crypt",
    "git",
    "encryption",
    "encrypted files",
    "secrets",
    "secret management",
    "gitattributes",
    "gpg",
    "explorer",
    "decorations",
    "security"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension runs Git commands and can explicitly update .gitattributes in the workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Git CLI attribute checks require local filesystem paths."
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.gitattributes"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitCryptDecorations.refresh",
        "title": "Refresh Decorations",
        "category": "Git Crypt",
        "icon": "$(refresh)"
      },
      {
        "command": "gitCryptDecorations.showStatus",
        "title": "Show Status",
        "category": "Git Crypt",
        "icon": "$(output)"
      },
      {
        "command": "gitCryptDecorations.initializeWithKey",
        "title": "Initialize/Unlock with Existing Key",
        "category": "Git Crypt"
      },
      {
        "command": "gitCryptDecorations.exportKey",
        "title": "Export Key",
        "category": "Git Crypt"
      },
      {
        "command": "gitCryptDecorations.initializeRepository",
        "title": "Initialize New Repository",
        "category": "Git Crypt"
      },
      {
        "command": "gitCryptDecorations.unlockWithGpg",
        "title": "Unlock with GPG",
        "category": "Git Crypt"
      },
      {
        "command": "gitCryptDecorations.lockRepository",
        "title": "Lock Repository",
        "category": "Git Crypt"
      },
      {
        "command": "gitCryptDecorations.addGpgUser",
        "title": "Add GPG User (No Auto-Commit)",
        "category": "Git Crypt"
      },
      {
        "command": "gitCryptDecorations.protectFile",
        "title": "Add to Encryption Targets",
        "category": "Git Crypt"
      },
      {
        "command": "gitCryptDecorations.unprotectFile",
        "title": "Remove from Encryption Targets",
        "category": "Git Crypt"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitCryptExplorer",
          "title": "Git Crypt Explorer",
          "icon": "images/activity-bar.svg"
        }
      ]
    },
    "views": {
      "gitCryptExplorer": [
        {
          "id": "gitCryptExplorer.repositories",
          "name": "Repositories",
          "icon": "$(lock)",
          "contextualTitle": "Git Crypt Explorer"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "gitCryptDecorations.protectFile",
          "when": "resourceScheme == file",
          "group": "gitCrypt@1"
        },
        {
          "command": "gitCryptDecorations.unprotectFile",
          "when": "resourceScheme == file",
          "group": "gitCrypt@2"
        }
      ],
      "view/title": [
        {
          "command": "gitCryptDecorations.refresh",
          "when": "view == gitCryptExplorer.repositories",
          "group": "navigation@1"
        },
        {
          "command": "gitCryptDecorations.showStatus",
          "when": "view == gitCryptExplorer.repositories",
          "group": "navigation@2"
        },
        {
          "command": "gitCryptDecorations.initializeWithKey",
          "when": "view == gitCryptExplorer.repositories",
          "group": "1_repository@1"
        },
        {
          "command": "gitCryptDecorations.initializeRepository",
          "when": "view == gitCryptExplorer.repositories",
          "group": "1_repository@2"
        },
        {
          "command": "gitCryptDecorations.unlockWithGpg",
          "when": "view == gitCryptExplorer.repositories",
          "group": "1_repository@3"
        },
        {
          "command": "gitCryptDecorations.lockRepository",
          "when": "view == gitCryptExplorer.repositories",
          "group": "1_repository@4"
        },
        {
          "command": "gitCryptDecorations.exportKey",
          "when": "view == gitCryptExplorer.repositories",
          "group": "2_keys@1"
        },
        {
          "command": "gitCryptDecorations.addGpgUser",
          "when": "view == gitCryptExplorer.repositories",
          "group": "2_keys@2"
        }
      ]
    },
    "configuration": {
      "title": "Git Crypt Explorer",
      "properties": {
        "gitCryptDecorations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show decorations for files protected by git-crypt."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test out/test/**/*.test.js",
    "package": "vsce package",
    "publish:marketplace": "npm run check && npm test && vsce publish"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
